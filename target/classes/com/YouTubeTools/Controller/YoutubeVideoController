package com.YouTubeTools.Controller;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;
import com.YouTubeTools.Model.VideoDetails;   //iss line me doubt hai YouTubeTools or YouTubetags
import com.YouTubeTools.Service.ThumbnailService;   //iss line me doubt hai YouTubeTools or YouTubetags
import com.YouTubeTools.Service.YouTubeService;   //iss line me doubt hai YouTubeTools or YouTubetags

@Controller
@RequiredArgsConstructor
public class YouTubeVideoController{

    private final ThumbnailService service;
    private final YouTubeVideoService youTubeVideoService;


    @GetMapping("/youtube/video-details")
    public String showVideoForm(){
        return "video-details";
    }

    @PostMapping("/youtube/video-details")
    public String fetchVideoDetails(@RequestParam String videoUrlOrId, Model model){
        String videoId = service.extractVideoId(videoUrlOrId);
        if (videoId == null) {
            model.addAttribute("error", "Invalid YouTube URL or Video ID.");
            
        }
        VideoDetails details = youTubeVideoService.getVideoDetails(videoId);
        if(details == null){
            model.addAttribute("error", "Could not fetch video details. Please check the Video ID or URL.");
        }
        
        
        else {
            model.addAttribute("videoDetails", details);
        }
        model.addAttribute("videoUrlOrId", videoUrlOrId);
        return "video-details";
    }
}